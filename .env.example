OPENAI_API_KEY=sk-proj-your-key

# Current model guidance is documented at:
# https://developers.openai.com/api/docs/models
# Use gpt-5.5 for strongest planning; use gpt-5.4-mini for lower cost/latency.
LAUNCH_DESK_MODEL=gpt-5.4-mini

# Optional. Keep tracing enabled by default in server runtimes.
# OPENAI_AGENTS_DISABLE_TRACING=1

PORT=8787

# Optional intelligence verification API keys.
# Keep real values in .env.local, never commit them.
FRED_API_KEY=
CENSUS_API_KEY=
OPEN_SUPPLY_HUB_API_KEY=
UN_COMTRADE_API_KEY=

# Model Gateway provider API keys (src/integration/)
# Used by ModelGatewayImpl for real model API calls with auto-switch.
# FakeModelGateway does not need these — it returns synthetic responses.
DEEPSEEK_API_KEY=
ARK_API_KEY=
OPENROUTER_API_KEY=
LONGCAT_API_KEY=

# Neon PostgreSQL (Agent swarm persistence — src/intelligence/memory/persistence/neon.ts)
# Used by NeonPersistenceAdapter when NEON_PERSISTENCE=1.
NEON_PROJECT_ID=
NEON_BRANCH_ID=
NEON_API_KEY=
DATABASE_URL=
NEON_PERSISTENCE=0

# szfiu stock market MCP servers (JWT Bearer token — shared by stock_cn/hk/us_f10 and _sdk)
# Used by Collector Agent for A股/港股/美股 F10+SDK data acquisition.
SZFIU_JWT_TOKEN=

# Luckin Coffee MCP (my-coffee server — 点单系统)
# Login to Luckin, copy the Bearer token, paste here.
# When set, change my-coffee descriptor `enabled` to true in src/mcp/descriptors.ts.
LKCOFFEE_JWT_TOKEN=

# ===== Security & Production Config =====

# #5 Approval gate — set to true for production to require approval on external copy
APPROVAL_ENABLED=true

# #11 CORS — comma-separated allowed origins (production domains)
CORS_ORIGINS=https://your-domain.vercel.app,https://your-domain.com

# #3 JWT Authentication — set AUTH_ENABLED=true to protect API endpoints
# When enabled, all /api/* endpoints (except /api/health and /api/auth/login)
# require a valid Bearer token obtained from POST /api/auth/login.
AUTH_ENABLED=false
# JWT signing secret — use a strong random string (>= 32 chars). Required when AUTH_ENABLED=true.
JWT_SECRET=
# Admin credentials for POST /api/auth/login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Token expiration (jsonwebtoken format: "24h", "7d", "1h" etc.)
JWT_EXPIRES_IN=24h

# #7 APM (Sentry) — leave SENTRY_DSN empty to disable
# Get your DSN from https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
